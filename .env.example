# Template for the platform's environment — copy, then fill in the values:
#
#   cp .env.example .env.local   # local development (`npm run dev`)
#   cp .env.example .env         # Docker (`docker compose up`)
#
# Both copies are git-ignored; never commit real values. Variables are
# validated in src/env.ts (better-auth reads BETTER_AUTH_* on its own).

# --- Runtime (read by the server at startup) ---------------------------------

# Secret for signing sessions — a long random string, different per
# environment (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=

# Public URL users reach the platform at (local dev: http://localhost:3000;
# Docker via compose: http://localhost:8080; QA/Production: the real domain).
BETTER_AUTH_URL=http://localhost:3000

# --- Backend ------------------------------------------------------------------

# Origin of the platform's FastAPI backend: scheme + host[:port], no path and
# no trailing slash (e.g. an ngrok tunnel, https://api-qa.example.com). The
# browser always calls same-origin `/api/v1`; this is where it's forwarded —
# by the Vite dev server (`npm run dev`) or the nginx proxy (Docker).
BACKEND_URL=

# --- Build time (VITE_*: baked into the bundle by `npm run build`) -----------
# In Docker only VITE_APP_TITLE is passed to the build (as a build arg); the
# others stay unset there.

# `true` serves mock data (MSW) instead of calling the backend — see
# docs/mock-api.md. Never enable it for a deployed build.
# VITE_ENABLE_MOCKS=true

# Browser tab title. Unset → "Cuperz Homecenter".
# VITE_APP_TITLE=

# --- Docker Compose only -----------------------------------------------------

# Host port the proxy listens on.
HTTP_PORT=8080
