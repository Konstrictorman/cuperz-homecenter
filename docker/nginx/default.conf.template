# Single public origin for the platform: `/api/v1/*` goes to the FastAPI
# backend, everything else to the TanStack Start (Nitro) server. This is what
# lets the image be built without VITE_API_BASE_URL — the browser always calls
# same-origin `/api/v1`.
#
# The official nginx image renders this template with envsubst at startup;
# only ${BACKEND_URL} is substituted (see NGINX_ENVSUBST_FILTER in
# compose.yaml) — plain `$var`s below are nginx's own variables.

server {
    listen 80;
    server_name _;

    client_max_body_size 10m;

    # BACKEND_URL is an origin only (scheme + host[:port], no path, no trailing
    # slash), so the original `/api/v1/...` URI is passed through unchanged.
    location /api/v1/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Skips ngrok's browser interstitial when the backend is tunneled;
        # ignored by anything else.
        proxy_set_header ngrok-skip-browser-warning true;
        # PDF generation waits on Homecenter.
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
